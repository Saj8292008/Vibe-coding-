# ---- Phone HUD (on by default) ----
# Port the phone HUD listens on. Set 0 to turn it off.
# HUD_PORT=8787
# Address to listen on. 0.0.0.0 = reachable over Tailscale/Wi-Fi (needs the secret link).
# HUD_HOST=0.0.0.0
# Link to print/send instead of the auto-detected one, e.g. your Tailscale MagicDNS name:
# HUD_PUBLIC_URL=http://my-desktop.tailnet-name.ts.net:8787
# Name shown for this computer in the HUD
# HUD_MACHINE_LABEL=Gaming PC

# ---- Telegram pings (optional) ----
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Run `python3 herdr_phone.py --whoami`, message your bot, paste the number here
TELEGRAM_CHAT_ID=
# HERDR_PHONE_NOTIFY=blocked,done
# HERDR_PHONE_TAIL_LINES=25

# ---- herdr ----
# HERDR_SESSION=
